# ---------------------------------------------------------------------------
# Modele du fichier de configuration d'EQUIPE du connecteur JIRA.
#
# Sa place n'est PAS ici. Il se depose dans :
#
#     08_ENGINE/04_mcp/00_config/jira.shared.env
#
# Ce fichier-ci n'est qu'un modele versionne a cote du serveur, pour que le
# contenu attendu ne se perde pas. Le deposer dans 00_config/ est une ECRITURE
# DANS LE COLLECTIF : elle prend effet sur tous les postes au prochain demarrage
# de session, et une valeur fausse casse les vingt-six en meme temps. Se verifie
# avec /jira-setup apres depot.
#
# Ce qu'il porte : ce qui est identique d'un poste a l'autre. Un reglage ressaisi
# vingt-six fois, ce sont vingt-six occasions de diverger et une correction qui
# ne se propage jamais - c'est ce qui a fait rater la mise en service de Yooz.
#
# LISTE BLANCHE A LA LECTURE. Le serveur ne reprend d'ici que :
#   - JIRA_TENANTS, JIRA_PAGE_SIZE, JIRA_MAX_PAGES, JIRA_TIMEOUT_S,
#     JIRA_DEFAULT_TENANT ;
#   - par tenant, les suffixes _BASE_URL, _LABEL, _AUTH, _CLOUD_ID, _CLIENT_ID,
#     _EMAIL et _TOKEN.
# Tout le reste est IGNORE et signale par /jira-setup. Ce n'est pas une barriere
# anti-secret - voir ci-dessous, le jeton passe - c'est un garde-fou contre la
# faute de frappe, qui sinon passerait inapercue sur les vingt-six postes.
#
# Priorite : configuration du plugin > jira.env du poste > CE FICHIER > defaut du
# serveur. Un poste peut donc surcharger n'importe quelle ligne d'ici sans la
# modifier - c'est la sortie pour un acces nominatif ou une instance de recette.
# ---------------------------------------------------------------------------

# Les deux instances. Un collegue qui n'a acces qu'a l'une restreint la liste
# dans SA configuration de plugin, pas ici.
JIRA_TENANTS=PROJET,WF

# --- PROJET : l'instance metier -------------------------------------------

JIRA_PROJET_LABEL=vuproject - l'instance Vente-unique (metier)
JIRA_PROJET_BASE_URL=https://vuproject.atlassian.net

# cloudId, releve le 2026-09-01 sur
# https://api.atlassian.com/oauth/token/accessible-resources.
# Il ne sert QUE si un poste passe en mode oauth : en mode basic, on parle
# directement au site. Ce n'est pas un secret - c'est un identifiant d'instance.
JIRA_PROJET_CLOUD_ID=d02c7c4b-4d86-4324-98fa-90ef9b5f0db9

# --- WF : l'instance de la WebFacto ---------------------------------------

JIRA_WF_LABEL=webfacto - l'instance de la WebFacto (developpement)
JIRA_WF_BASE_URL=https://webfacto.atlassian.net

# cloudId non releve : personne n'avait d'acces API a cette instance au moment
# de la construction du connecteur. A completer par le premier qui en obtient un.
# JIRA_WF_CLOUD_ID=

# --- Les identifiants : une decision d'equipe, pas un defaut --------------
#
# Le serveur ACCEPTE ici le couple JIRA_<TENANT>_EMAIL + JIRA_<TENANT>_TOKEN,
# comme shiptify et yooz, parce que ce sont les identifiants d'un compte de
# SERVICE : ils n'identifient personne, ils valent pour l'equipe. Les faire
# ressaisir vingt-six fois n'ajouterait aucune protection - seulement vingt-six
# mises en service qui echouent et une rotation impossible a propager.
#
# CE QUE CA IMPLIQUE, ET QU'IL FAUT ASSUMER AVANT DE REMPLIR CES LIGNES.
#
#   1. Cette bibliotheque est lisible par toute l'equipe L&T : le jeton l'est
#      aussi. C'est le prix du reglage partage, il est connu et accepte.
#   2. Un jeton Jira autorise l'ECRITURE - creer un ticket, changer un statut,
#      commenter - meme si ce connecteur n'emet que des GET. Le compte de
#      service doit donc etre provisionne avec les droits les plus FAIBLES qui
#      repondent a la question : idealement une lecture sur SUPPLY et VUD, pas
#      un administrateur.
#   3. Ce qui serait fait avec ce jeton serait trace sous SON nom, pas sous
#      celui d'une personne. C'est acceptable pour de la lecture ; ca ne l'est
#      pas pour une action qui engage quelqu'un.
#   4. Le jour ou un acces doit etre nominatif - audit, prestataire externe,
#      tracabilite - la reponse est la configuration du plugin sur le poste, qui
#      passe DEVANT ce fichier. On ne retire pas la ligne, on la surcharge chez
#      soi.
#
# LE COUPLE EST OBLIGATOIRE. Jira Cloud refuse un jeton envoye sans courriel et
# rend un 401 qui ressemble a un mauvais jeton. C'est la premiere cause d'echec.
#
# LES DEUX JETONS SONT DIFFERENTS. Un jeton est lie a un compte, et le compte
# doit avoir ete invite sur chaque instance : le jeton de vuproject rend 401 sur
# webfacto. Si le compte de service n'existe que sur une instance, laisse
# l'autre couple commente - le connecteur dira proprement qu'elle n'est pas
# configuree au lieu de rendre des erreurs.
#
# Le jeton se cree sur https://id.atlassian.com/manage-profile/security/api-tokens
# depuis le compte de service. Atlassian n'expose AUCUNE API pour en creer un :
# c'est une action d'interface, et aucun connecteur ne la contourne.
#
# A remplir par la personne qui detient le compte de service, directement dans
# 00_config/jira.shared.env - pas ici, et jamais dans une conversation.

# JIRA_PROJET_EMAIL=
# JIRA_PROJET_TOKEN=
# JIRA_WF_EMAIL=
# JIRA_WF_TOKEN=

# --- Plafonds -------------------------------------------------------------

# Taille de page. Plafond impose par l'API de recherche : 100.
JIRA_PAGE_SIZE=100

# Garde-fou de pagination, PAR TENANT et par requete. 50 pages de 100 = 5 000
# tickets. A relever ici pour un export annuel sur VUD, qui porte des milliers
# de tickets par mois - en gardant en tete que Jira Cloud limite le debit par
# compte, et qu'un 429 arrete tout. Le debit etant compte PAR COMPTE, un compte
# de service partage par vingt-six postes partage aussi son quota : c'est la
# contrepartie a surveiller.
JIRA_MAX_PAGES=50

# Delai d'attente par appel HTTP, en secondes.
JIRA_TIMEOUT_S=60

# --- Ce qui ne peut PAS etre ici -----------------------------------------
#
# JIRA_*_CLIENT_SECRET   -> secret du mode oauth : refuse ET signale
# JIRA_*_REFRESH_TOKEN   -> idem
#
#   La raison est MECANIQUE, pas politique : Atlassian fait tourner le refresh
#   token a chaque renouvellement et invalide le precedent. Deux postes qui le
#   partagent se le cassent mutuellement, et le second echoue definitivement -
#   il faut alors refaire le consentement a la main. Un refresh token n'a qu'un
#   detenteur possible. Le mode oauth se configure donc sur UN poste, dans son
#   jira.env.
#
# JIRA_TOKEN / JIRA_EMAIL sans prefixe -> ambigus des qu'il y a deux instances
# JIRA_EXPORT_DIR        -> chemin local, propre a chaque poste
# JIRA_ENV_FILE          -> idem
# JIRA_CACHE_DB          -> idem
#
# Ces valeurs sont ignorees ET signalees si elles sont posees ici.
