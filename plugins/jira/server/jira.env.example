# ---------------------------------------------------------------------------
# Modele du fichier de configuration LOCAL du connecteur JIRA.
#
# Sa place n'est PAS ici. Il se copie, se remplit et se depose dans :
#
#     ~/.jira-mcp/jira.env
#
#   Windows : C:\Users\<login>\.jira-mcp\jira.env
#   macOS   : /Users/<login>/.jira-mcp/jira.env
#
# Le profil utilisateur, et PAS %LOCALAPPDATA% : un Python empaquete (Microsoft
# Store, Python Manager) donne a ses processus enfants une vue virtualisee de
# %LOCALAPPDATA%, et un fichier pose la peut etre invisible pour le serveur sans
# aucune erreur. Lecon mesuree en empaquetant le connecteur Yooz le 2026-08-27.
#
# Le fichier s'appelle jira.env, PAS .env. Un fichier nomme .env serait ignore
# en silence - c'est ce qui est arrive chez Yooz.
#
# A ENREGISTRER SANS BOM (UTF-8 simple). Un BOM UTF-8 non consomme colle trois
# octets invisibles devant le premier nom de variable, qui devient introuvable :
# la premiere ligne du fichier est alors perdue en silence.
#
# CE FICHIER EST OPTIONNEL, ET DANS LE CAS COURANT INUTILE.
#
# Les identifiants de l'equipe - le couple courriel + jeton du compte de
# SERVICE - vivent dans 08_ENGINE/04_mcp/00_config/jira.shared.env, que le
# serveur va lire tout seul. Commence donc par /jira-setup : si l'equipe
# fournit deja les identifiants, il n'y a RIEN a poser ici.
#
# Ce fichier sert a trois choses, et a trois choses seulement :
#   1. SURCHARGER le reglage d'equipe sur ce poste - typiquement un acces
#      NOMINATIF, pour que JIRA trace ce qu'on fait sous son propre nom et non
#      sous celui du compte de service, ou une instance de recette ;
#   2. l'installation DIRECTE, hors plugin ;
#   3. le mode oauth, dont les deux secrets ne peuvent PAS etre partages (voir
#      le mode 3 plus bas).
#
# Ce qu'il porte est LOCAL et ne se copie jamais dans la bibliotheque SharePoint
# de l'equipe : le serveur refuse d'ecrire ou de lire des identifiants dans un
# dossier synchronise, et il refuse aussi qu'on les colle dans une conversation.
#
# En mode plugin, /plugin > jira > configuration fait la meme chose que ce
# fichier et garde les valeurs hors de la transcription.
#
# Priorite : configuration du plugin > CE FICHIER > jira.shared.env d'equipe >
# defaut du serveur.
# ---------------------------------------------------------------------------

# Les instances interrogeables. Une instance = un jeu d'identifiants.
# A restreindre a une seule si l'on n'a pas d'acces a l'autre : le connecteur
# cesse alors de compter le tenant absent comme une panne.
JIRA_TENANTS=PROJET,WF

# ===========================================================================
# MODE 1 - basic : courriel + jeton d'API. LE PLUS SIMPLE, et le defaut.
# ===========================================================================
#
# Deux lignes par instance, rien a inscrire cote Atlassian.
#
# Le jeton se cree a la main, une fois, sur
#     https://id.atlassian.com/manage-profile/security/api-tokens
# « Create API token », un libelle parlant, puis copier la valeur - elle ne se
# reaffiche jamais.
#
# ATLASSIAN N'EXPOSE AUCUNE API POUR CREER CE JETON. C'est volontaire : le jeton
# porte l'identite de la personne. Aucun connecteur ne peut donc s'en fabriquer
# un. Ce qui est automatisable, c'est le renouvellement d'un jeton d'ACCES OAuth :
# voir le mode 3.
#
# LE COUPLE EST OBLIGATOIRE. Jira Cloud refuse un jeton envoye sans courriel, et
# rend un 401 qui ressemble a un mauvais jeton. C'est la premiere cause d'echec.
#
# LES DEUX JETONS SONT DIFFERENTS, meme si le compte Atlassian est le meme : un
# jeton est lie a un compte, et le compte doit avoir ete invite sur chaque
# instance. Un 401 sur WF alors que PROJET fonctionne n'est pas une faute de
# saisie, c'est un probleme d'acces - ca se demande a la WebFacto.

# A NE REMPLIR QUE si /jira-setup dit qu'il manque quelque chose, ou pour
# surcharger le compte de service par un acces nominatif sur ce poste.

# --- PROJET : vuproject.atlassian.net (le metier : SUPPLY, VUD) ------------
# JIRA_PROJET_EMAIL=prenom.nom@vente-unique.com
# JIRA_PROJET_TOKEN=collez-ici-le-jeton-vuproject

# --- WF : webfacto.atlassian.net (les developpements) ----------------------
# JIRA_WF_EMAIL=prenom.nom@vente-unique.com
# JIRA_WF_TOKEN=collez-ici-le-jeton-webfacto

# ===========================================================================
# MODE 2 - bearer : un jeton d'acces obtenu ailleurs, envoye tel quel.
# ===========================================================================
#
# Pour un jeton a portees (scoped token) ou un jeton d'acces recupere par un
# autre outil. Il expire, et rien ici ne le renouvelle.
#
# JIRA_PROJET_AUTH=bearer
# JIRA_PROJET_TOKEN=le-jeton-d-acces

# ===========================================================================
# MODE 3 - oauth : le seul ou plus rien n'expire a la main.
# ===========================================================================
#
# Le serveur renouvelle le jeton d'acces tout seul aupres de
# https://auth.atlassian.com/oauth/token, avant expiration, et suit la rotation
# du refresh token (il reecrit la nouvelle valeur dans ce fichier).
#
# Ce qu'il faut avoir avant : une application inscrite dans la console
# developpeur Atlassian (client_id + client_secret), les portees de lecture
# (read:jira-work, read:jira-user, offline_access), et un premier consentement
# obtenu a la main - c'est ce consentement qui rend le refresh token.
#
# CE MODE PASSE PAR UN CADRAGE WEBFACTO : inscrire une application OAuth sur le
# domaine Atlassian de l'entreprise n'est pas un geste individuel.
#
# Le cloudId est obligatoire : un jeton OAuth ne s'envoie pas au site
# atlassian.net, il s'envoie a la passerelle api.atlassian.com avec l'identifiant
# de l'instance. Il se lit sur
# https://api.atlassian.com/oauth/token/accessible-resources.
# Celui de vuproject, releve le 2026-09-01 :
# d02c7c4b-4d86-4324-98fa-90ef9b5f0db9
#
# JIRA_PROJET_AUTH=oauth
# JIRA_PROJET_CLOUD_ID=d02c7c4b-4d86-4324-98fa-90ef9b5f0db9
# JIRA_PROJET_CLIENT_ID=...
# JIRA_PROJET_CLIENT_SECRET=...
# JIRA_PROJET_REFRESH_TOKEN=...

# ===========================================================================
# Reglages locaux, tous optionnels
# ===========================================================================

# Ou atterrissent les exports CSV. Defaut : ~/.jira-mcp/exports.
# JAMAIS un dossier de la bibliotheque partagee : un CSV depose dans un dossier
# synchronise part chez les vingt-six personnes de l'equipe.
# JIRA_EXPORT_DIR=C:/Users/<login>/Documents/exports-jira

# Le cache local SQLite. Defaut : ~/.jira-mcp/jira_cache.sqlite
# JIRA_CACHE_DB=

# Pointer explicitement le fichier de configuration d'equipe. A ne renseigner
# que si le connecteur ne le trouve pas seul (jira_doctor le dit).
# ATTENTION : un chemin explicite est EXCLUSIF - il desactive la recherche
# automatique, il ne la complete pas.
# JIRA_SHARED_ENV=C:/Users/<login>/CAFOM/Transport BtoC - Documents/08_ENGINE/04_mcp/00_config/jira.shared.env

# Ou pointer la racine 08_ENGINE, si la bibliotheque est synchronisee ailleurs.
# VU_ENGINE_DIR=

# Plafonds. A ne toucher que pour un export large.
# JIRA_PAGE_SIZE=100
# JIRA_MAX_PAGES=50
# JIRA_TIMEOUT_S=60
