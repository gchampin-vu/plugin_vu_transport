# Modele de configuration du serveur MCP shiptify.
#
# NE PAS renseigner de cle ici. Ce fichier est un MODELE, et il vit dans une
# bibliotheque SharePoint synchronisee avec toute l'equipe L&T.
#
# Le vrai fichier va dans   %LOCALAPPDATA%\shiptify-mcp\.env
# et install.ps1 le cree pour toi :
#   powershell -ExecutionPolicy Bypass -File "10_ENGINE/mcp_shiptify/install.ps1"
#
# Le serveur REFUSE de lire un .env situe dans un dossier synchronise : ce
# n'est pas une recommandation, c'est verifie a l'execution.

# --- Obligatoire ---------------------------------------------------------

# Cle d'API Shiptify. Envoyee dans l'en-tete Authorization.
# Si elle contient des caracteres speciaux (%, *, /, #), mets-la entre
# guillemets doubles.
SHIPTIFY_API_KEY="a-remplacer"

# --- Optionnel ----------------------------------------------------------

# Racine de l'API. Par defaut https://api.shiptify.com
# SHIPTIFY_BASE_URL=https://api.shiptify.com

# Prefixe de l'en-tete Authorization. Par defaut "Api-Key", ce qui donne
# Authorization: Api-Key <cle>. Mettre "Bearer" si Shiptify change de schema.
# SHIPTIFY_AUTH_PREFIX=Api-Key

# Compte Shiptify a utiliser, envoye en X-Account-ID. Ne le renseigne que si
# un appel rend un HTTP 403 : shiptify_accounts liste les comptes autorises.
# SHIPTIFY_ACCOUNT_ID=

# Garde-fou de pagination : nombre maximum de pages de 100 lignes par requete.
# 60 pages = 6000 lignes. A relever pour un export annuel volumineux.
# SHIPTIFY_MAX_PAGES=60

# Delai d'attente par appel HTTP, en secondes.
# SHIPTIFY_TIMEOUT_S=60

# Dossier des exports CSV. Par defaut <vault>/Assets/shiptify.
# Un export est une donnee, pas un secret : sa place est dans le vault.
# SHIPTIFY_EXPORT_DIR=

# Emplacement explicite du fichier .env, si tu ne veux pas de celui par defaut.
# Se renseigne dans l'environnement, pas ici : le serveur lit cette variable
# AVANT d'ouvrir le fichier.
# SHIPTIFY_ENV_FILE=
