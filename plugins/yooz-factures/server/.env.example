# ---------------------------------------------------------------------------
# Modele de configuration du serveur MCP yooz-factures, pour le mode DIRECT.
#
# En mode plugin, ce fichier est inutile : la configuration est saisie dans les
# champs du plugin a son installation, et les secrets vont dans le coffre du
# poste. Ce fichier ne sert qu'au mode direct (diagnostic, synchro planifiee,
# session hors Claude Code).
#
# NE PAS remplir ce fichier ici : il est dans le vault, donc dans une
# bibliotheque SharePoint partagee avec l'equipe L&T. Les secrets n'y ont pas
# leur place (regle 1 du cerveau commun).
#
# Copie-le a l'emplacement attendu, hors du vault, et remplis-le la-bas :
#   ~\.yooz-mcp\yooz.env        (install.ps1 le fait pour toi)
# Emplacements lus, dans l'ordre : YOOZ_ENV_FILE, %CLAUDE_PLUGIN_DATA%\yooz.env,
# ~\.yooz-mcp\yooz.env, puis l'ancien %LOCALAPPDATA%\yooz-mcp\yooz.env.
# Le serveur refuse de lire un fichier situe dans un dossier synchronise.
# ---------------------------------------------------------------------------

# Region Yooz. eu1 pour Vente-unique.
YOOZ_BASE_URL=https://eu1.getyooz.com

# Les societes a interroger : une cle par societe, en minuscules, sans accent.
# La cle sert de prefixe aux variables ci-dessous et d'argument aux outils
# (company="distriservice").
YOOZ_COMPANIES=distriservice,vente_unique

# Identifiant du data report factures. Il est le meme pour les deux societes
# dans la configuration actuelle ; s'il diverge, utilise
# YOOZ_<SOCIETE>_REPORT_ID pour surcharger.
# L'outil yooz_reports liste les rapports disponibles avec leur identifiant.
YOOZ_DEFAULT_REPORT_ID=1faf71e2-3c8b-4b4e-a94b-3acc79436153

# --- DistriService ---------------------------------------------------------
YOOZ_DISTRISERVICE_LABEL=DistriService
YOOZ_DISTRISERVICE_CLIENT_ID=
YOOZ_DISTRISERVICE_CLIENT_SECRET=
YOOZ_DISTRISERVICE_REFRESH_TOKEN=
YOOZ_DISTRISERVICE_APPLICATION_ID=
# YOOZ_DISTRISERVICE_REPORT_ID=

# --- Vente-unique ----------------------------------------------------------
YOOZ_VENTE_UNIQUE_LABEL=Vente-Unique
YOOZ_VENTE_UNIQUE_CLIENT_ID=
YOOZ_VENTE_UNIQUE_CLIENT_SECRET=
YOOZ_VENTE_UNIQUE_REFRESH_TOKEN=
YOOZ_VENTE_UNIQUE_APPLICATION_ID=
# YOOZ_VENTE_UNIQUE_REPORT_ID=

# --- Options ---------------------------------------------------------------
# Colonnes ecartees du cache (listes imbriquees). Defaut : YZ_INVOICE_LINE,
# comme le Table.RemoveColumns du script Power Query d'origine.
# YOOZ_DROP_COLUMNS=YZ_INVOICE_LINE
# Emplacement du cache SQLite. Defaut : %LOCALAPPDATA%\yooz-mcp\yooz_cache.sqlite
# YOOZ_CACHE_DB=
# Dossier des exports CSV. Defaut : %LOCALAPPDATA%\yooz-mcp\exports
# YOOZ_EXPORT_DIR=
