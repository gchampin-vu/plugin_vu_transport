          "in": "query",
          "name": "pageSize",
          "required": true,
          "type": "integer"
        },
        {
          "description": "If provided, only visitors that have changed since the given datetime are returned. Format: 2023-01-01T00:00:00+00:00 (url encoding for '+' = '%2B'). If format is incorrect we will ignore the filter.",
          "enum": null,
          "in": "query",
          "name": "updatedSince",
          "required": false,
          "type": "datetime"
        },
        {
          "description": "If provided, only visitors that have a profile validity after the given date are returned. Format: 2023-01-01. If format is incorrect we will ignore the filter.",
          "enum": null,
          "in": "query",
          "name": "validityFrom",
          "required": false,
          "type": "date"
        },
        {
          "description": "If provided, only visitors that have a profile validity before the given date are returned. Format: 2023-01-01. If format is incorrect we will ignore the filter.",
          "enum": null,
          "in": "query",
          "name": "validityUntil",
          "required": false,
          "type": "date"
        },
        {
          "description": "Specifies the type of datetime field (e.g., SlotStart, Arrived, CheckedIn, Departed) that will be used to filter visitors. This works in conjunction with the timestampFilterStart and timestampFilterEnd parameters to limit results based on the selected datetime range.",
          "enum": [
            "SlotStart",
            "CheckedIn",
            "Arrived",
            "Departed"
          ],
          "in": "query",
          "name": "timestampFilterField",
          "required": false,
          "type": "string"
        },
        {
          "description": "Filters visitors by the start of the datetime range, as specified by the timestampFilterField. The provided datetime should be in ISO 8601 format: YYYY-MM-DDTHH:MM:SS±HH:MM (e.g., 2023-01-01T00:00:00+02:00, 2023-01-01T00:00:00Z). Please note that the '+' character in the timezone should be URL-encoded as %2B.",
          "enum": null,
          "in": "query",
          "name": "timestampFilterStart",
          "required": false,
          "type": "datetime"
        },
        {
          "description": "Filters visitors by the end of the datetime range, as specified by the timestampFilterField. The provided datetime should be in ISO 8601 format: YYYY-MM-DDTHH:MM:SS±HH:MM (e.g., 2023-01-01T00:00:00+00:00, 2023-01-01T00:00:00Z). Please note that the '+' character in the timezone should be URL-encoded as %2B.",
          "enum": null,
          "in": "query",
          "name": "timestampFilterEnd",
          "required": false,
          "type": "datetime"
        },
        {
          "description": "If provided, only visitors with a profile assigned to this site are returned",
          "enum": null,
          "in": "query",
          "name": "siteId",
          "required": false,
          "type": "integer"
        },
        {
          "description": "If provided, only visitors in this visitor status are returned.",
          "enum": [
            "Logged",
            "WaitingForApproval",
            "WaitingSequence",
            "WaitingForDispatch",
            "CheckedIn",
            "CheckedOut",
            "Blocked",
            "WaitingForDocuments",
            "ReadyForCheckout"
          ],
          "in": "query",
          "name": "status",
          "required": false,
          "type": "string"
        },
        {
          "description": "",
          "enum": [
            "SystemField",
            "CustomField",
            "CurrentHost"
          ],
          "in": "query",
          "name": "searchObject",
          "required": false,
          "type": "string"
        },
        {
          "description": "For 'searchObject' equal to SystemField, the 'searchField' must be a property that exists in the system default configuration (Pincode/Status/CurrentLocation). For 'searchObject' equal to CustomField, the 'searchField' must be the technical name of a custom field. For 'searchObject' equal to CurrentHost, the 'searchField' must be a property from the Host (Name, Email or Mobile). The current host of a visitor is the host of the profile for the current day, the first profile in the future or the host that has created the visitor. SearchField is case sensitive.",
          "enum": null,
          "in": "query",
          "name": "searchField",
          "required": false,
          "type": "string"
        },
        {
          "description": "matches the exact value for the selected searchField parameter. SearchText is case sensitive",
          "enum": null,
          "in": "query",
          "name": "searchText",
          "required": false,
          "type": "string"
        }
      ],
      "summary": "get visitors, paginated"
    },
