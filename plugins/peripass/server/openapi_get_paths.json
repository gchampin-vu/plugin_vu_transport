    "/visitors": {
      "operationId": "getVisitors",
      "parameters": [
        {
          "description": "zero based",
          "enum": null,
          "in": "query",
          "name": "pageNumber",
          "required": true,
          "type": "integer"
        },
        {
          "description": "",
