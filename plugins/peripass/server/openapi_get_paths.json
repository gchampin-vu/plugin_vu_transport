    "/visitors/{reference}": {
      "operationId": "getVisitorByReference",
      "parameters": [
        {
          "description": "The unique reference of a visitor. This consists of two parts: the type of identifier and the value of the identifier, separated by a colon. The identifier of the Peripass technical id is \"id\". A custom field can be used as an identifier. In this case the technical name of that custom field should be used. Examples: \"id:10\" or \"tms_id:90\". If no identifier is provided, the Peripass technical id will be used by default. <br> <br> The reference cannot contain a : or . character. The reference can contain other special characters (like a _ or a - or a space), however these should be url-encoded.",
